<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Stripe.Hosting.Aspire</RootNamespace>
    <!-- ATS export support is currently experimental in Aspire; suppress informational warning. -->
    <NoWarn>$(NoWarn);ASPIREATS001</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Stripe.Hosting.Aspire</PackageId>
    <Description>Aspire hosting integration for the Stripe CLI — run the Stripe webhook proxy via local CLI or Docker alongside your Aspire app during development.</Description>
    <PackageTags>stripe;aspire;webhooks;payments;hosting;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.5.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stripe.Hosting.Aspire.Tests" />
  </ItemGroup>

</Project>
