<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <!--
      IsAotCompatible is deliberately NOT set: it is a package-level promise that cannot be
      honoured end to end, because Stripe.net deserializes with reflection.
      netstandard2.1 also predates the trim and AOT analyzers.
    -->
    <!-- Intercepts IConfiguration.Bind with generated, reflection-free binding code. -->
    <EnableConfigurationBindingGenerator Condition="'$(TargetFramework)' != 'netstandard2.1'">true</EnableConfigurationBindingGenerator>
    <!--
      StripeOptions.HttpClient is a Stripe.IHttpClient. It is set in code via AddStripe(o => ...),
      never from configuration, and an interface has no constructor for the binder to call. The
      generator reports that it skipped the property; skipping it is the intended behaviour.
    -->
    <NoWarn>$(NoWarn);SYSLIB1100;SYSLIB1101</NoWarn>
    <RootNamespace>Stripe.Extensions.DependencyInjection</RootNamespace>
  </PropertyGroup>
  
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Stripe .NET extension library to help with DI registration. </Description>
    <PackageId>Stripe.Extensions.DependencyInjection</PackageId>
    <PackageTags>stripe;dotnet;dependencyinjection;payments;</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stripe.net" Version="52.4.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

</Project>
