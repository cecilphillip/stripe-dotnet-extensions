<Project Sdk="Aspire.AppHost.Sdk/13.5.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>stripe-dotnet-extensions-sample-apphost</UserSecretsId>
    <!-- Required by Aspire 13.5+ for CLI-driven features such as `aspire publish` (ASPIRE010). -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Stripe.Hosting.Aspire\Stripe.Hosting.Aspire.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\SampleCheckout\SampleCheckout.csproj" />
    <ProjectReference Include="..\SampleEventNotifications\SampleEventNotifications.csproj" />
  </ItemGroup>

</Project>
